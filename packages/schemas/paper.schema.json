{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-intelligence.local/schemas/paper.schema.json",
  "title": "Research Intelligence Paper",
  "description": "Strict metadata, provenance and local processing references for a paper in the local workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "title",
    "authors",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "enum": ["m2.v1", "m4d.v1"] },
    "paper_id": { "$ref": "#/$defs/stableId" },
    "title": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "author_details": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/authorDetail" }
    },
    "year": { "type": "integer", "minimum": 0 },
    "publication_venue": { "type": "string", "maxLength": 500 },
    "publisher": { "type": "string", "maxLength": 500 },
    "volume": { "type": "string", "maxLength": 500 },
    "issue": { "type": "string", "maxLength": 500 },
    "page_start": { "type": "string", "maxLength": 500 },
    "page_end": { "type": "string", "maxLength": 500 },
    "article_number": { "type": "string", "maxLength": 500 },
    "edition": { "type": "string", "maxLength": 500 },
    "language": { "type": "string", "maxLength": 500 },
    "publication_type": { "type": "string" },
    "doi": { "type": ["string", "null"], "maxLength": 256 },
    "identifiers": { "$ref": "#/$defs/identifiers" },
    "external_identifiers": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 256 }
    },
    "publication_status": { "type": "string" },
    "research_type": { "type": "string" },
    "methodological_subtype": { "type": "string" },
    "evidence_structure": { "type": "string" },
    "abstract": { "type": "string", "maxLength": 100000 },
    "keywords": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "url": { "type": "string", "format": "uri", "maxLength": 2000 },
    "metadata_provenance": { "$ref": "#/$defs/metadataProvenance" },
    "pdf_access_status": {
      "enum": [
        "pdf_ready",
        "open_access",
        "repository_version",
        "institutional_access_required",
        "manual_upload_required",
        "abstract_only",
        "unavailable"
      ]
    },
    "local_pdf_path": {
      "type": ["string", "null"],
      "description": "Workspace-relative local PDF path when available."
    },
    "source_version_type": { "type": "string" },
    "assigned_project_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "project_relevance_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectRelevanceRecord" }
    },
    "reading_progress_id": {
      "description": "Stable reading progress ID referencing reading-progress.schema.json.",
      "$ref": "#/$defs/stableId"
    },
    "processing_state": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance_ids": {
      "type": "array",
      "description": "Stable provenance IDs referencing provenance.schema.json.",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/historyEvent" }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "authorDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "given_name": { "type": "string", "maxLength": 300 },
        "family_name": { "type": "string", "maxLength": 300 },
        "literal_name": { "type": "string", "maxLength": 300 },
        "suffix": { "type": "string", "maxLength": 100 },
        "orcid": { "type": "string", "maxLength": 256 }
      },
      "anyOf": [
        { "required": ["given_name"] },
        { "required": ["family_name"] },
        { "required": ["literal_name"] }
      ]
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": { "type": "string", "maxLength": 256 },
        "pmid": { "type": "string", "maxLength": 256 },
        "pmcid": { "type": "string", "maxLength": 256 },
        "arxiv_id": { "type": "string", "maxLength": 256 },
        "isbn": { "type": "string", "maxLength": 256 },
        "issn": { "type": "string", "maxLength": 256 },
        "other": { "type": "string", "maxLength": 256 }
      }
    },
    "metadataProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_origin"],
      "properties": {
        "record_origin": { "enum": ["manual", "imported_record", "system_derived"] }
      }
    },
    "projectRelevanceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id"],
      "properties": {
        "project_id": { "$ref": "#/$defs/stableId" },
        "relevance_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "relevance_explanation": { "type": "string" }
      }
    },
    "historyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "created_at"],
      "properties": {
        "event_id": { "$ref": "#/$defs/stableId" },
        "event_type": { "type": "string", "minLength": 1 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "provenance_id": { "$ref": "#/$defs/stableId" }
      }
    }
  }
}
