{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-intelligence.local/schemas/processing-record.schema.json",
  "title": "Research Intelligence AI Processing Record",
  "description": "Strict local processing event for bounded test operations and explicitly confirmed paper summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "processing_id", "workspace_id", "operation_id", "operation_type",
    "prompt_id", "prompt_version", "prompt_fingerprint", "provider_type", "model", "parameters",
    "input_fingerprint", "source_snapshot", "source_snapshot_fingerprint", "cache_key",
    "cache_disposition", "status", "requested_at", "updated_at", "attempt_count", "stale",
    "invalidated", "provenance"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "operation_id": { "const": "provider_echo_test" },
            "operation_type": { "const": "provider_echo_test" },
            "prompt_id": { "const": "task5b.provider_echo_test" },
            "source_snapshot": { "$ref": "#/$defs/syntheticSource" },
            "output": { "anyOf": [{ "$ref": "#/$defs/echoOutput" }, { "type": "null" }] },
            "provenance": { "$ref": "#/$defs/echoProvenance" }
          }
        },
        {
          "required": ["project_id", "paper_id"],
          "properties": {
            "operation_id": { "const": "paper_summary" },
            "operation_type": { "const": "paper_summary" },
            "prompt_id": { "const": "paper.summary" },
            "source_snapshot": { "$ref": "#/$defs/paperSummarySource" },
            "output": { "anyOf": [{ "$ref": "#/$defs/summaryOutput" }, { "type": "null" }] },
            "provenance": { "$ref": "#/$defs/summaryProvenance" }
          }
        }
      ]
    },
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": {
        "required": ["output", "completed_at"],
        "properties": { "output": { "not": { "type": "null" } }, "completed_at": { "$ref": "#/$defs/timestamp" } }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["failed", "cancelled"] } } },
      "then": {
        "required": ["output", "error", "completed_at"],
        "properties": {
          "output": { "type": "null" },
          "error": { "$ref": "#/$defs/error" },
          "completed_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    {
      "if": { "properties": { "cache_disposition": { "const": "cache_hit" } } },
      "then": { "required": ["original_processing_id"] }
    }
  ],
  "properties": {
    "schema_version": { "const": "m5b.v1" },
    "processing_id": { "$ref": "#/$defs/stableId" },
    "workspace_id": { "$ref": "#/$defs/stableId" },
    "project_id": { "$ref": "#/$defs/stableId" },
    "paper_id": { "$ref": "#/$defs/stableId" },
    "operation_id": { "type": "string", "enum": ["provider_echo_test", "paper_summary"] },
    "operation_type": { "type": "string", "enum": ["provider_echo_test", "paper_summary"] },
    "prompt_id": { "type": "string", "enum": ["task5b.provider_echo_test", "paper.summary"] },
    "prompt_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "prompt_fingerprint": { "$ref": "#/$defs/sha256" },
    "provider_type": { "enum": ["fake", "openai"] },
    "model": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^\\S+$" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "input_fingerprint": { "$ref": "#/$defs/sha256" },
    "source_snapshot": { "anyOf": [{ "$ref": "#/$defs/syntheticSource" }, { "$ref": "#/$defs/paperSummarySource" }] },
    "source_snapshot_fingerprint": { "$ref": "#/$defs/sha256" },
    "cache_key": { "$ref": "#/$defs/sha256" },
    "cache_disposition": { "enum": ["cache_miss", "cache_hit", "bypassed", "unavailable", "invalidated"] },
    "original_processing_id": { "$ref": "#/$defs/stableId" },
    "retry_of_processing_id": { "$ref": "#/$defs/stableId" },
    "status": { "enum": ["queued", "running", "completed", "failed", "cancelled"] },
    "requested_at": { "$ref": "#/$defs/timestamp" },
    "started_at": { "$ref": "#/$defs/nullableTimestamp" },
    "completed_at": { "$ref": "#/$defs/nullableTimestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "attempt_count": { "type": "integer", "minimum": 1, "maximum": 3 },
    "output": { "anyOf": [{ "$ref": "#/$defs/echoOutput" }, { "$ref": "#/$defs/summaryOutput" }, { "type": "null" }] },
    "output_fingerprint": { "$ref": "#/$defs/nullableSha256" },
    "usage": { "anyOf": [{ "$ref": "#/$defs/usage" }, { "type": "null" }] },
    "provenance": { "anyOf": [{ "$ref": "#/$defs/echoProvenance" }, { "$ref": "#/$defs/summaryProvenance" }] },
    "error": { "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] },
    "stale": { "type": "boolean" },
    "invalidated": { "type": "boolean" }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "maxLength": 160 },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "nullableSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["temperature", "max_output_tokens"],
      "properties": { "temperature": { "type": "number", "minimum": 0, "maximum": 1 }, "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1024 } }
    },
    "syntheticSource": {
      "type": "object", "additionalProperties": false, "required": ["source_type", "synthetic_input_version"],
      "properties": { "source_type": { "const": "synthetic" }, "synthetic_input_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$" } }
    },
    "paperSummarySource": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "project_id", "paper_id", "source_id", "source_sha256", "extraction_id", "extraction_full_text_sha256", "extraction_status", "preparation_version", "page_count", "included_page_count", "included_characters", "truncated", "metadata_fingerprint", "prepared_text_fingerprint"],
      "properties": {
        "source_type": { "const": "paper_extraction" }, "project_id": { "$ref": "#/$defs/stableId" }, "paper_id": { "$ref": "#/$defs/stableId" }, "source_id": { "$ref": "#/$defs/stableId" },
        "source_sha256": { "$ref": "#/$defs/sha256" }, "extraction_id": { "$ref": "#/$defs/stableId" }, "extraction_full_text_sha256": { "$ref": "#/$defs/sha256" },
        "extraction_status": { "const": "completed" }, "preparation_version": { "const": "paper-summary-source.v1" }, "page_count": { "type": "integer", "minimum": 1, "maximum": 500 },
        "included_page_count": { "type": "integer", "minimum": 1, "maximum": 60 }, "included_characters": { "type": "integer", "minimum": 20, "maximum": 62000 }, "truncated": { "type": "boolean" },
        "metadata_fingerprint": { "$ref": "#/$defs/sha256" }, "prepared_text_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "echoOutput": {
      "type": "object", "additionalProperties": false, "required": ["contract_id", "acknowledgement", "synthetic_input_version"],
      "properties": { "contract_id": { "const": "task5b.provider_echo_ack.v1" }, "acknowledgement": { "const": "Synthetic provider processing completed." }, "synthetic_input_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$" } }
    },
    "summaryOutput": {
      "type": "object", "additionalProperties": false, "required": ["contract_id", "summary", "key_points", "limitations", "open_questions"],
      "properties": {
        "contract_id": { "const": "paper-summary.v1" }, "summary": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "key_points": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "limitations": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "open_questions": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens"],
      "properties": { "input_tokens": { "type": "integer", "minimum": 0, "maximum": 200000 }, "output_tokens": { "type": "integer", "minimum": 0, "maximum": 4096 } }
    },
    "echoProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_type", "operation_id", "prompt_id", "prompt_version", "prompt_fingerprint", "provider_type", "model", "parameters", "input_fingerprint", "source_type", "cache_key", "cache_disposition", "recorded_at"],
      "properties": {
        "provenance_type": { "const": "ai_processing" }, "operation_id": { "const": "provider_echo_test" }, "prompt_id": { "const": "task5b.provider_echo_test" }, "prompt_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "prompt_fingerprint": { "$ref": "#/$defs/sha256" }, "provider_type": { "enum": ["fake", "openai"] }, "model": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^\\S+$" }, "parameters": { "$ref": "#/$defs/parameters" }, "input_fingerprint": { "$ref": "#/$defs/sha256" }, "source_type": { "const": "synthetic" }, "cache_key": { "$ref": "#/$defs/sha256" }, "cache_disposition": { "enum": ["cache_miss", "cache_hit", "bypassed", "unavailable", "invalidated"] }, "original_processing_id": { "$ref": "#/$defs/stableId" }, "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "summaryProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_type", "operation_id", "prompt_id", "prompt_version", "prompt_fingerprint", "provider_type", "model", "parameters", "input_fingerprint", "source_type", "cache_key", "cache_disposition", "recorded_at"],
      "properties": {
        "provenance_type": { "const": "ai_processing" }, "operation_id": { "const": "paper_summary" }, "prompt_id": { "const": "paper.summary" }, "prompt_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "prompt_fingerprint": { "$ref": "#/$defs/sha256" }, "provider_type": { "enum": ["fake", "openai"] }, "model": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^\\S+$" }, "parameters": { "$ref": "#/$defs/parameters" }, "input_fingerprint": { "$ref": "#/$defs/sha256" }, "source_type": { "const": "paper_extraction" }, "cache_key": { "$ref": "#/$defs/sha256" }, "cache_disposition": { "enum": ["cache_miss", "cache_hit", "bypassed", "unavailable", "invalidated"] }, "original_processing_id": { "$ref": "#/$defs/stableId" }, "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["category", "message"],
      "properties": {
        "category": { "enum": ["invalid_output", "authentication_failed", "rate_limited", "model_not_found", "network_unavailable", "timeout", "cancelled", "provider_unavailable", "unexpected_provider_error", "processing_unavailable", "stale_revision", "source_invalid", "source_insufficient", "source_unavailable", "extraction_required", "paper_missing", "paper_unavailable", "project_mismatch", "provider_not_ready", "prompt_unavailable", "retry_limit", "invalid_state", "record_scope_mismatch"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
